# Скопируйте в .env и заполните. Файл .env не коммитится.

NODE_ENV=development
PORT=3000
DATABASE_URL=postgres://postgres:postgres@localhost:5432/hud

# Секрет для хеширования одноразовых кодов входа (в продакшене — длинная случайная строка).
APP_SECRET=dev-secret-change-me-in-production

# Адреса приложений (для ссылок-приглашений).
PUBLIC_STUDENT_URL=http://localhost:5173
PUBLIC_ADMIN_URL=http://localhost:5174

# Только для разработки: фиксированный код входа вместо SMS.
DEV_OTP_CODE=111111

# SMS: console (печать в лог) | smsru
SMS_PROVIDER=console
SMSRU_API_ID=

# ИИ: local (правила и шаблоны, без внешних сервисов) | gigachat | yandexgpt
AI_PROVIDER=local
GIGACHAT_AUTH_KEY=
GIGACHAT_SCOPE=GIGACHAT_API_PERS
GIGACHAT_MODEL=GigaChat
YANDEX_API_KEY=
YANDEX_FOLDER_ID=
YANDEX_MODEL=yandexgpt-lite/latest

# Что видит ученица после окончания доступа: read_only | blocked
ACCESS_AFTER_END=read_only

# Прокси перед сервером (Caddy/Nginx) — true в продакшене.
TRUST_PROXY=false

# Web Push (уведомления на телефон). Сгенерировать: pnpm --filter @hud/api vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:support@example.ru

# Бот Telegram (необязательно; в РФ Telegram ограничивают)
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=

# Бот MAX (необязательно)
MAX_BOT_TOKEN=
MAX_BOT_NAME=
MAX_WEBHOOK_SECRET=
# MAX_API_URL=https://platform-api2.max.ru
# MAX_DEEPLINK_TEMPLATE=https://max.ru/{bot}?start={payload}

# Двухфакторная защита кабинета обязательна (по умолчанию: true в продакшене, false в разработке)
# STAFF_TOTP_REQUIRED=true
