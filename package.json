{
  "name": "hud33m",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm -r --parallel --filter @hud/api --filter @hud/student --filter @hud/admin dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "db:generate": "pnpm --filter @hud/db generate",
    "db:migrate": "pnpm --filter @hud/db migrate",
    "db:seed": "pnpm --filter @hud/db seed",
    "create-admin": "pnpm --filter @hud/api create-admin"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  }
}
